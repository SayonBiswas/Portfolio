<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<input type="checkbox" id="theme-toggle" class="visually-hidden" aria-hidden="true">
<input type="checkbox" id="nav-toggle"   class="visually-hidden" aria-hidden="true">

<div class="site">

  <!-- ── Navbar ── -->
  <nav class="navbar">
    <div class="wrap nav-inner">
      <a href="#" class="nav-logo" style="font-family: var(--syne); font-size: 1.5rem; font-weight: 800; color: var(--fg);">SB.</a>

      <div class="nav-links">
        {% for link in nav_links %}
        <a href="#{{ link.id }}" style="text-transform: uppercase; font-size: 0.75rem;">{{ link.name }}</a>
        {% endfor %}
        <a href="#contact" class="btn-primary" style="margin-left: 1rem;">Let's talk →</a>
        <label for="theme-toggle" class="icon-btn" tabindex="0" aria-label="Toggle theme" style="margin-left: 0.5rem;">
          {{ icon('sun',  cls='theme-icon-sun',  size=15) | safe }}
          {{ icon('moon', cls='theme-icon-moon', size=15) | safe }}
        </label>
      </div>

      <div style="display:flex;align-items:center;gap:0.5rem;">
        <label for="nav-toggle" class="icon-btn menu-toggle-btn" tabindex="0" aria-label="Toggle menu">
          {{ icon('menu', cls='icon-menu', size=17) | safe }}
          {{ icon('close', cls='icon-close', size=17) | safe }}
        </label>
      </div>
    </div>
    <div class="wrap mobile-menu">
      {% for link in nav_links %}
      <a href="#{{ link.id }}" style="text-transform: uppercase;">{{ link.name }}</a>
      {% endfor %}
      <a href="#contact" class="btn-primary" style="margin: 0.5rem 0;">Let's talk →</a>
      <label for="theme-toggle" class="mobile-theme-toggle" tabindex="0" aria-label="Toggle theme">
        <span class="theme-icon-sun">{{ icon('sun', size=15) | safe }} Light Mode</span>
        <span class="theme-icon-moon">{{ icon('moon', size=15) | safe }} Dark Mode</span>
      </label>
    </div>
  </nav>

  <main>

    <!-- ── Hero ── -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
            <span style="width: 8px; height: 8px; background: var(--lime); border-radius: 50%;"></span>
            <span class="text-label-caps" style="color: var(--fg2);">AVAILABLE FOR OPPORTUNITIES</span>
          </div>
          <h1 style="font-family: var(--syne); font-size: clamp(3rem, 8vw, 6rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; margin-bottom: 0.5rem;">
            Sayon
          </h1>
          <h2 style="font-family: var(--playfair); font-style: italic; font-size: clamp(2rem, 5vw, 4rem); font-weight: 400; line-height: 1.1; color: var(--fg);">
            Biswas
          </h2>
          <div style="margin-top: 1.5rem; font-family: var(--mono); font-size: 0.9rem; color: var(--fg2);">
            Python Developer & Backend Engineer // Aspiring Data Scientist
          </div>
          <p class="text-body-lg" style="margin-top: 1.5rem; color: var(--fg2); max-width: 28rem;">
            {{ hero.blurb }}
          </p>
          <div class="social-row">
            {% for s in socials %}
            <a class="social-btn" href="{{ s.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.name }}">
              {{ icon(s.name, size=18) | safe }}
            </a>
            {% endfor %}
          </div>
          {% if contact.resume %}
          <div style="margin-top: 1.5rem;">
            <a href="{{ contact.resume }}" download class="btn-primary">
              Download Resume
            </a>
          </div>
          {% endif %}
        </div>

        <div class="hero-photo-wrap">
          <div class="hero-photo-card">
            {% if hero.photo %}
            <img src="{{ hero.photo }}" alt="{{ hero.first_name }} {{ hero.last_name }}">
            {% else %}
            <div class="hero-photo-placeholder">// add photo in content.py</div>
            {% endif %}
            <div class="hero-photo-location">
              Jamshedpur / India / 2026
            </div>
            <div class="hero-sb-badge">
              SB.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Selected Work (Projects) ── -->
    <section id="projects" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">THINGS_I_BUILT</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            Selected <span class="text-italic-serif">work.</span>
          </h2>
          <p style="font-family: var(--inter); font-size: 0.9rem; color: var(--fg3); max-width: 20rem; margin-bottom: 3rem;">
            Projects shaped by curiosity, care, and a lot of Python.
          </p>
        </div>
      </div>
      <div class="wrap">
        <p class="text-label-caps" style="color: var(--lime); margin-bottom: 1.5rem;">✓ completed</p>
        <div class="grid-2" style="margin-bottom: 3rem;">
          {% for p in projects_completed %}
          <div class="bento-card" style="padding: 0; overflow: hidden;">
            <div class="project-img-wrap">
              <div class="chip-completed">✓ completed</div>
              {% if p.image %}
              <img src="{{ p.image }}" alt="{{ p.title }}">
              {% else %}
              <div class="img-placeholder">// {{ p.title }}</div>
              {% endif %}
              <div class="project-img-meta">
                <span class="project-num">{{ p.number }}</span>
                <span class="project-tech-inline">{{ p.tech | join(' / ') }}</span>
              </div>
            </div>
            <div style="padding: 1.5rem;">
              <h3 style="font-family: var(--syne); font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem;">{{ p.title }}</h3>
              <p class="text-body-md" style="color: var(--fg2); margin-bottom: 1rem;">{{ p.description }}</p>
              <a href="project_{{ p.title | project_url }}.html" class="btn-ghost" style="font-size: 0.8rem;">
                View case study → {{ icon('arrow-right', size=12) | safe }}
              </a>
            </div>
          </div>
          {% endfor %}
        </div>

        <p class="text-label-caps" style="color: var(--orange); margin-bottom: 1.5rem;">~ ongoing</p>
        <div class="grid-2">
          {% for p in projects_ongoing %}
          <div class="bento-card" style="padding: 0; overflow: hidden;">
            <div class="project-img-wrap">
              <div class="chip-ongoing">~ ongoing</div>
              {% if p.image %}
              <img src="{{ p.image }}" alt="{{ p.title }}">
              {% else %}
              <div class="img-placeholder">// {{ p.title }}</div>
              {% endif %}
              <div class="project-img-meta">
                <span class="project-num">{{ p.number }}</span>
                <span class="project-tech-inline">{{ p.tech | join(' / ') }}</span>
              </div>
            </div>
            <div style="padding: 1.5rem;">
              <h3 style="font-family: var(--syne); font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem;">{{ p.title }}</h3>
              <p class="text-body-md" style="color: var(--fg2); margin-bottom: 1rem;">{{ p.description }}</p>
              <a href="project_{{ p.title | project_url }}.html" class="btn-ghost" style="font-size: 0.8rem;">
                View case study → {{ icon('arrow-right', size=12) | safe }}
              </a>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ── About (Who I Am) ── -->
    <section id="about" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">WHO_I_AM</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            Curious by nature.
          </h2>
          <h3 class="text-display-lg" style="color: var(--orange); margin-bottom: 1.5rem;">
            Builder by choice.
          </h3>
          <p class="text-body-lg" style="color: var(--fg2); margin-bottom: 2rem;">
            {% for p in about.paragraphs %}{{ p }}{% endfor %}
          </p>
          <div class="grid-2">
            {% for card in about.cards %}
            <div class="bento-card">
              <h3 style="font-family: var(--mono); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--fg);">{{ card.title }}</h3>
              <p style="font-size: 0.9rem; color: var(--fg2); line-height: 1.6;">{{ card.text }}</p>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Education ── -->
    <section id="education" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">ACADEMIC_BACKGROUND</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            My <span class="text-italic-serif">education.</span>
          </h2>
          {% for e in education %}
          <div class="timeline-row">
            <div class="timeline-date">{{ e.period }}</div>
            <div class="timeline-content">
              <h4>{{ e.degree }}</h4>
              <p class="timeline-school">{{ e.school }}</p>
              <p class="timeline-desc">{{ e.text }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ── Experience ── -->
    <section id="experience" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">WORK_HISTORY</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            Learning through <span style="color: var(--orange);">real problems.</span>
          </h2>
          {% for job in experience %}
          <div class="timeline-row">
            <div class="timeline-date">{{ job.period }}</div>
            <div class="timeline-content">
              <h4>{{ job.role }}</h4>
              <p class="timeline-school">{{ job.org }}</p>
              <p class="timeline-desc">
                {% for b in job.bullets %}
                <span style="color: var(--lime);">→</span> {{ b }}{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              </p>
              {% if job.tech %}
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
                {% for t in job.tech %}<span class="tech-tag">{{ t }}</span>{% endfor %}
              </div>
              {% endif %}
              {% if job.github %}
              <div style="margin-top: 1rem;">
                <a href="{{ job.github }}" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size: 0.8rem;">
                  {{ icon('github', size=12) | safe }} View on GitHub
                </a>
              </div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ── Skills ── -->
    <section id="skills" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">TECH_STACK</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            Tools for <span style="color: var(--orange);">making things.</span>
          </h2>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            {% for cat in skills %}
              {% for s in cat.skills %}
              <span class="tech-tag">{{ s }}</span>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Achievements & Certifications ── -->
    <section id="achievements" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">RECOGNITION</span>
        </div>
        <div class="col-content">
          <p class="text-label-caps" style="color: var(--lime); margin-bottom: 1.5rem;">✓ achievements</p>
          {% for a in achievements %}
          <div style="border-top: 1px solid var(--border-dim); padding-top: 1.5rem; padding-bottom: 1.5rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; background: rgba(132,204,22,0.1); border-radius: 2px; color: var(--lime); flex-shrink: 0;">
                {{ icon(a.icon, size=16) | safe }}
              </div>
              <div>
                <h3 style="font-family: var(--syne); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem;">{{ a.title }}</h3>
                <p style="font-size: 0.9rem; color: var(--fg2); line-height: 1.6;">{{ a.text }}</p>
              </div>
            </div>
          </div>
          {% endfor %}

          <p class="text-label-caps" style="color: var(--cyan); margin: 2rem 0 1.5rem;">~ certifications</p>
          {% for c in certifications %}
          <div style="border-top: 1px solid var(--border-dim); padding-top: 1.5rem; padding-bottom: 1.5rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; background: rgba(0,219,233,0.1); border-radius: 2px; color: var(--cyan); flex-shrink: 0;">
                {{ icon(c.icon, size=16) | safe }}
              </div>
              <div style="flex: 1;">
                <h3 style="font-family: var(--syne); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem;">{{ c.title }}</h3>
                <p style="font-size: 0.9rem; color: var(--fg2); line-height: 1.6; margin-bottom: 0.5rem;">{{ c.text }}</p>
                {% if c.image %}
                <a href="{{ c.image }}" target="_blank" rel="noopener" style="font-family: var(--mono); font-size: 0.8rem; color: var(--cyan);">View certificate →</a>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ── Clubs (only if non-empty) ── -->
    {% if clubs %}
    <section id="clubs" class="section-2col">
      <div class="wrap">
        <div class="col-label">
          <span class="eyebrow">COMMUNITY</span>
        </div>
        <div class="col-content">
          <h2 class="text-display-lg">
            Clubs & <span style="color: var(--orange);">Communities</span>
          </h2>
          {% for c in clubs %}
          <div style="border-top: 1px solid var(--border-dim); padding-top: 1.5rem; padding-bottom: 1.5rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; background: rgba(255,107,53,0.1); border-radius: 2px; color: var(--orange); flex-shrink: 0;">
                {{ icon('users', size=16) | safe }}
              </div>
              <div>
                <h3 style="font-family: var(--syne); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem;">{{ c.title }}</h3>
                <p style="font-family: var(--mono); font-size: 0.8rem; color: var(--fg3); margin-bottom: 0.5rem;">{{ c.role }}</p>
                <p style="font-size: 0.9rem; color: var(--fg2); line-height: 1.6;">{{ c.text }}</p>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <!-- ── Contact / Footer ── -->
    <footer class="site-footer" id="contact">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-label">GET_IN_TOUCH</div>
          <div class="footer-content">
            <h2 class="footer-heading">
              Let's make<br>
              <span class="footer-heading-italic">something useful.</span>
            </h2>
            <a class="footer-email" href="mailto:{{ contact.email }}">
              {{ contact.email }} →
            </a>
            <div class="footer-meta">
              <div>
                <span class="footer-meta-label">PHONE</span>
                <a href="{{ contact.phone_href }}">{{ contact.phone }}</a>
              </div>
              {% if contact.resume %}
              <div>
                <span class="footer-meta-label">RESUME</span>
                <a href="{{ contact.resume }}" download>Download PDF →</a>
              </div>
              {% endif %}
              <p style="flex: 1; min-width: 100%;">{{ contact.note if contact.note else "Feel free to reach out — I'm always excited to connect and discuss new opportunities!" }}</p>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-links">
            <a href="{{ socials[0].url }}">GitHub</a>
            <a href="{{ socials[1].url }}">LinkedIn</a>
          </div>
          <p>{{ footer.copyright }}</p>
        </div>
      </div>
    </footer>

  </main>

</div>
</body>
</html>
